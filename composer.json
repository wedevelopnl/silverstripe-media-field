{
    "name": "wedevelopnl/silverstripe-media-field",
    "description": "Media field module",
    "keywords": [
        "silverstripe",
        "media",
        "field"
    ],
    "authors": [{
        "name": "WeDevelop",
        "email": "development@wedevelop.nl"
    }],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "silverstripe/cms": "^6",
        "unclecheese/display-logic": "^4.0",
        "embed/embed": "^4.0",
        "silverstripe/asset-admin": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.50",
        "cambis/silverstan": "^2.1"
    },
    "extra": {
        "installer-name": "silverstripe-media-field",
        "branch-alias": {
            "dev-main": "6.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "WeDevelop\\MediaField\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": false,
            "silverstripe/vendor-plugin": false,
            "silverstripe/recipe-plugin": false
        }
    }
}
